# ==============================================================================
# DEEP CANDLE // ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and adjust credentials for local development or remote deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ENGINE & TIMEFRAMES
# ------------------------------------------------------------------------------
# Comma or JSON formatted asset universe and timeframes
TRACKED_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT","DOGEUSDT"]
TIMEFRAMES=["15m","1h","5m"]

# Binance Public Market Data Streaming Endpoints
# Local Dev / Production: Official Binance public WebSocket & REST APIs
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_REST_URL=https://api.binance.com/api/v3/klines

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL 16)
# ------------------------------------------------------------------------------
# Local Docker container runs on port 5440 to avoid local host port conflicts (5432/5433).
POSTGRES_USER=deepcandle
POSTGRES_PASSWORD=deepcandle_password
POSTGRES_DB=deepcandle
POSTGRES_HOST=localhost
POSTGRES_PORT=5440

# Asynchronous connection string for asyncpg / SQLAlchemy
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://deepcandle:deepcandle_password@localhost:5440/deepcandle

# ------------------------------------------------------------------------------
# 3. AI INFERENCE & PROXY SETTINGS (CRO REASONING GATE)
# ------------------------------------------------------------------------------
# Production: Oracle Cloud VPS via Tailscale mesh: http://100.114.145.1:3009/v1/chat/completions
# Local Mock / Fallback: http://127.0.0.1:3009/v1/chat/completions
PROXY_URL=http://100.114.145.1:3009/v1/chat/completions
PROXY_MODEL=gemini-3.1-pro-low
PROXY_TIMEOUT_SEC=4.5

# ------------------------------------------------------------------------------
# 4. OPERATIONAL CO-PILOT & SECURITY (RONIN AUTONOMOUS LEDGER)
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Authorized Telegram Admin Chat ID (strictly enforced by security whitelist)
TELEGRAM_ADMIN_CHAT_ID=

# Emergency Circuit Breaker Flag File
# Touched by /panic command; checked on every 15m candle close by Live Orchestrator
EMERGENCY_HALT_FILE=/tmp/deep_candle_halt.flag

# ------------------------------------------------------------------------------
# 5. MODEL INFERENCE PARAMETERS
# ------------------------------------------------------------------------------
# Path to trained LightGBM statistical barrier classifier
MODEL_PATH=backend/app/ml/artifacts/deepcandle_lgbm_v1.txt

# Quantitative setup trigger gating threshold (Calibrated baseline: P(Setup) >= 0.50)
SIGNAL_THRESHOLD=0.50
